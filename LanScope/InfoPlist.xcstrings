{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - NSLocalNetworkUsageDescription",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to probe the local network addresses you choose over Wi-Fi and to read device names and types via Bonjour, UPnP, NetBIOS and host names. Responding devices are shown only on this device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于通过 Wi-Fi 探测你指定的局域网地址，并通过 Bonjour、UPnP、NetBIOS 和主机名读取设备名称与类型，在本机显示有响应的设备。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - NSLocationWhenInUseUsageDescription",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to read the current Wi-Fi name and save it to scan history. Your location is not collected or stored. Allow Precise Location to show the Wi-Fi name; declining doesn't affect scanning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于读取当前 Wi-Fi 名称并保存到扫描历史，不收集或保存你的位置。允许精确位置后可显示 Wi-Fi 名称，拒绝不影响扫描。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
